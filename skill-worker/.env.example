# skill-worker 环境变量模板：复制为 .env（或 K8s Deployment env）后按环境修改。
# 变量定义见 skill_worker/config.py；本地 dev 基础设施均为 Docker（127.0.0.1）。

# MySQL（dev 单库 dev-skill；生产为 skill_platform 分库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=dev-skill
MYSQL_USER=root
MYSQL_PASSWORD=root123456

# Redis（usage / progress / 看门狗防抖计数）
REDIS_URL=redis://127.0.0.1:6379/0

# 对象存储（S3 兼容，全私有桶；对外一律预签名）
# 网关侧由 STORAGE_PROVIDER=oss|cos 决定生效哪套配置；worker 侧 boto3 按 endpoint 直连，
# 供应商无关——填 OSS 或 COS 任一即可，但必须与网关当前生效的桶保持一致。
# 当前使用腾讯云 COS 标准端点（自定义 CDN 域名不支持 S3 签名 API，勿用）
OSS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
OSS_REGION=ap-guangzhou
OSS_BUCKET=<你的桶名（COS 需带 APPID 后缀）>
OSS_ACCESS_KEY=<你的 AccessKey>
OSS_SECRET_KEY=<你的 SecretKey>
# 桶内统一前缀：必须与 gateway 的 skill-platform.storage.key-prefix 一致
OSS_KEY_PREFIX=skill-platform/
# 切换阿里云 OSS 时改为（示例）：
# OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# OSS_REGION=cn-shenzhen
# OSS_BUCKET=<你的桶名>

# RocketMQ（namesrv；broker 注册地址须为 127.0.0.1，见 ~/docker/dev/broker.conf 的 brokerIP1）
ROCKETMQ_NAMESRV=127.0.0.1:9876

# 模型网关：指向 gateway 的 OpenAI 兼容端点（后管 model_provider 即路由配置，改了即时生效）
LITELLM_BASE_URL=http://127.0.0.1:8888

# billing-service（结算 RPC 主路径）
BILLING_BASE_URL=http://localhost:8081
INTERNAL_TOKEN=dev-internal-token

# 与 gateway 的 skill-platform.crypto-key 完全一致（base64 32B，用于回调 HMAC 的
# AppSecret 解密）——两边不一致会导致回调签名/解密全部失败
CRYPTO_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── 飞书群告警（可选）：自定义机器人 webhook，未配置即 no-op ──
# 群设置 → 群机器人 → 添加自定义机器人 → Webhook 地址；SECRET 为机器人"加签"密钥（未开启加签则留空）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# FEISHU_SECRET=
# RUNNING 超过该秒数告警一次（0=关闭）；单任务 token 超限告警（0=关闭）
# ALERT_RUNNING_SECONDS=600
# ALERT_TOKENS=200000
